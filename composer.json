{
    "name": "graduate-job-connect/platform",
    "description": "Professional recruitment platform connecting Ethiopian university graduates with employers",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage/"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
