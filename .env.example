APP_NAME="Graduate Job Connect"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/Graduate%20Job%20Connect

DB_HOST=localhost
DB_PORT=3306
DB_NAME=job_portal
DB_USER=root
DB_PASS=

SESSION_NAME=gjc_session
SESSION_LIFETIME=7200
BCRYPT_COST=12

# File Uploads
UPLOAD_MAX_SIZE=5242880

# Pagination
DEFAULT_PER_PAGE=12

# Mail & Email OTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DEFAULT_FROM_EMAIL=noreply@graduatejobconnect.com
DEFAULT_FROM_NAME="Graduate Job Connect"

REQUIRE_EMAIL_VERIFICATION=true
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
